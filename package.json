{
  "name": "apipost-mcp-cli",
  "version": "1.6.0",
  "description": "ApiPost MCP - API文档管理工具，支持接口创建、修改、查看、类型生成和批量操作",
  "main": "dist/index.js",
    "bin": {
      "apipost-mcp": "dist/cli.js"
    },
    "files": [
      "dist/"
    ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "node -r dotenv/config dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "debugger": "npx @modelcontextprotocol/inspector tsx -r dotenv/config src/index.ts",
    "gen:mcp-json": "node scripts/gen-mcp-json.mjs",
    "setup:claude-code": "npm run gen:mcp-json && node scripts/setup-claude-code.mjs",
    "setup:codex": "npm run gen:mcp-json && node scripts/setup-codex.mjs",
    "setup:cursor": "npm run gen:mcp-json && node scripts/setup-cursor.mjs",
    "setup:windsurf": "npm run gen:mcp-json && node scripts/setup-windsurf.mjs",
    "setup:trae": "npm run gen:mcp-json && node scripts/setup-trae.mjs",
    "setup:qoder": "npm run gen:mcp-json && node scripts/setup-qoder.mjs",
        "setup:workbuddy": "npm run gen:mcp-json && node scripts/setup-workbuddy.mjs",
        "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "apipost",
    "api",
    "documentation",
    "cursor",
    "type-generation",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lniev/mcp-apipost"
  },
  "author": "lniev <LnievV@outlook.com> (https://github.com/lniev)",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.21",
    "dotenv": "^17.4.2",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
